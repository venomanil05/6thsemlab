@model q8.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<h1>Edit Book</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label>Book Title</label>
        <input asp-for="Title" />
    </div>

    <br />

    <div>
        <label>Author</label>
        <input asp-for="Author" />
    </div>

    <br />

    <div>
        <label>Category</label>
        <input asp-for="Category" />
    </div>

    <br />

    <div>
        <label>Price</label>
        <input asp-for="Price"
               type="number"
               step="0.01" />
    </div>

    <br />

    <div>
        <label>Quantity</label>
        <input asp-for="Quantity"
               type="number" />
    </div>

    <br />

    <button type="submit">
        Save Changes
    </button>

</form>

<br />

<a asp-action="Index">
    Back to Book List
</a>