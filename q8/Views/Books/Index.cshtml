@model IEnumerable<q8.Models.Book>

@{
    ViewData["Title"] = "Library Books";
}

<h1>Library Management System</h1>

<p>
    <a asp-action="Create">
        Add New Book
    </a>
</p>

<table border="1" cellpadding="10">

    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Author</th>
        <th>Category</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Actions</th>
    </tr>

    @foreach (var book in Model)
    {
        <tr>
            <td>@book.Id</td>

            <td>@book.Title</td>

            <td>@book.Author</td>

            <td>@book.Category</td>

            <td>@book.Price</td>

            <td>@book.Quantity</td>

            <td>
                <a asp-action="Edit"
                   asp-route-id="@book.Id">
                    Edit
                </a>

                |

                <a asp-action="Delete"
                   asp-route-id="@book.Id">
                    Delete
                </a>
            </td>
        </tr>
    }

</table>
